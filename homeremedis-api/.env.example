# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ──────────────────────────────────────────────────────────────────
# For local:
MONGO_URI=mongodb://127.0.0.1:27017/homeremedis

# ── Admin key ────────────────────────────────────────────────────────────────
# REQUIRED: generate a strong random key — e.g. `openssl rand -hex 32`
ADMIN_KEY=REPLACE_WITH_STRONG_RANDOM_KEY

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# For local dev: http://localhost:5173
# For production: https://your-deployed-frontend.vercel.app
FRONTEND_URL=http://localhost:5173
